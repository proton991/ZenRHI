# Embed privately fetched implementation sources in the archives so installed consumers only need Foundation.
if(TARGET spirv-reflect AND NOT ZENRHI_INSTALL)
    target_link_libraries(ZenRHICore PRIVATE spirv-reflect)
else()
    FetchContent_Declare(spirv_reflect URL https://codeload.github.com/KhronosGroup/SPIRV-Reflect/zip/refs/tags/vulkan-sdk-1.4.363.0
        URL_HASH SHA256=a4654a90fe938a3cba55952776f50f0f0a005143371ef6d076578ab1f41afce1 SOURCE_SUBDIR zen-no-cmake)
    FetchContent_MakeAvailable(spirv_reflect)
    target_sources(ZenRHICore PRIVATE "${spirv_reflect_SOURCE_DIR}/spirv_reflect.c")
    target_include_directories(ZenRHICore PRIVATE "${spirv_reflect_SOURCE_DIR}")
endif()
if(ZENRHI_INSTALL OR NOT TARGET volk)
    FetchContent_Declare(volk URL https://codeload.github.com/zeux/volk/zip/refs/tags/1.4.350
        URL_HASH SHA256=da737c3ea86880a4a9bbede7696e46955425d7ed373b7b2225c5bf2f23343e60 SOURCE_SUBDIR zen-no-cmake)
    FetchContent_MakeAvailable(volk)
    target_sources(ZenRHIVulkan PRIVATE "${volk_SOURCE_DIR}/volk.c")
    target_link_libraries(ZenRHIVulkan PRIVATE ${CMAKE_DL_LIBS})
endif()
if(ZENRHI_INSTALL OR NOT TARGET vma)
    FetchContent_Declare(vma URL https://codeload.github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator/zip/refs/tags/v3.4.0
        URL_HASH SHA256=ce9a61ea5e72284ac9ccc152c214eef381ab57bfd7383f20232e5a652e3afda6 SOURCE_SUBDIR zen-no-cmake)
    FetchContent_MakeAvailable(vma)
endif()

function(zenrhi_use_backend_headers target)
    if(TARGET volk AND NOT ZENRHI_INSTALL)
        target_link_libraries(${target} PRIVATE volk)
    else()
        target_include_directories(${target} PRIVATE "${volk_SOURCE_DIR}")
    endif()
    if(TARGET vma AND NOT ZENRHI_INSTALL)
        target_link_libraries(${target} PRIVATE vma)
    else()
        target_include_directories(${target} PRIVATE "${vma_SOURCE_DIR}/include")
    endif()
endfunction()
zenrhi_use_backend_headers(ZenRHIVulkan)
zenrhi_use_backend_headers(ZenRHI)
