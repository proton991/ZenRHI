@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Vulkan)
find_dependency(ZenFoundation @ZENRHI_FOUNDATION_ABI@ CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/ZenRHITargets.cmake")
if("TestSupport" IN_LIST ZenRHI_FIND_COMPONENTS)
    if(NOT TARGET GTest::gtest)
        find_dependency(GTest)
    endif()
    if(NOT TARGET ZenRHI::TestSupport)
        include("${CMAKE_CURRENT_LIST_DIR}/ZenRHITestSupportTargets.cmake")
        set_property(TARGET ZenRHI::TestSupport APPEND PROPERTY INTERFACE_LINK_LIBRARIES GTest::gtest)
    endif()
    set(ZenRHI_TestSupport_FOUND TRUE)
endif()
check_required_components(ZenRHI)
